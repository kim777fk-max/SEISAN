DATABASE_URL="postgresql://postgres:postgres@db:5432/factory_operation?schema=public"
PORT=3000

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Custom Search API (optional - for better search results)
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CSE_ID=your_google_cse_id_here

# News Collector Settings
NEWS_KEYWORDS=キャンプ,アウトドア,ソロキャンプ,キャンプギア,焚き火
RUN_ON_STARTUP=false
